{
  "urls": [
    ["https://example.com/watch?v=a&x=b", true],
    ["http://127.0.0.1:8080/video", true],
    ["HTTPS://example.com/video", true],
    ["https://", false],
    ["http://?", false],
    ["https:example.com", false],
    ["file:///tmp/video", false],
    ["https://user:secret@example.com/video", false],
    ["https://example.com/has space", false],
    ["https://example.com/\u0000", false]
  ],
  "rates": [
    ["1", true], ["500K", true], ["1.5m", true], ["0.5K", true],
    ["0", false], ["0K", false], [".", false], [".5M", false],
    ["1.", false], ["1.2.3K", false], ["1e9", false], ["Infinity", false],
    ["999999999999999999999999999999999999999999999999", false],
    ["1000000000001", false], ["0.1", false], ["1G", false]
  ],
  "timeouts": { "stallNoticeSeconds": 30, "defaultSeconds": 120, "conversionSeconds": 1800, "readBufferBytes": 32768 },
  "secretKeys": {
    "parts": ["token", "signature", "password", "credential", "secret", "apikey", "api_key", "api-key"],
    "exact": ["auth", "authorization", "authkey", "auth_key", "auth-key", "sig", "key", "hmac", "policy", "session", "sessionid", "session_id"],
    "redact": ["token", "access_token", "oauth_token", "X-Amz-Signature", "X-Amz-Credential", "X-Amz-Security-Token", "sig", "key", "hmac", "Policy", "session", "auth", "api_key", "x-api-key", "password", "%74oken"],
    "keep": ["v", "list", "index", "t", "author", "authority", "policy_name", "sessions", "keyword", "monkey", "monkeys", "signal", "id", "format"]
  },
  "retry": { "delays": [5, 15, 45], "afterLast": 60, "rateLimitCooldown": 60, "maxRetryAfter": 3600 }
}

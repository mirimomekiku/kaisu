{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaisu",
  "version": "0.0.1",
  "identifier": "com.kaisu.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kaisu",
        "decorations": false,
        "dragDropEnabled": false,
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
